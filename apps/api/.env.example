# Application
APP_NAME=Harry OS API
APP_ENV=local
APP_DEBUG=true
APP_VERSION=0.1.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://harry-os.vercel.app

# Security — change SECRET_KEY before any real deployment
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
REMEMBER_ME_REFRESH_TOKEN_TTL_DAYS=30
JWT_ALGORITHM=HS256
REFRESH_COOKIE_NAME=harry_os_refresh
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=60

# Database
# Local (no Docker): sqlite+aiosqlite:///./data/harry_os.db
# Docker MySQL:      mysql+aiomysql://harry:harry@db:3306/harry_os
DATABASE_URL=sqlite+aiosqlite:///./data/harry_os.db
DATABASE_ECHO=false

# Files
MEDIA_ROOT=/data/media
MAX_UPLOAD_BYTES=20971520

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# AI — set AI_ENABLED=true and LLM_API_KEY for live writing polish + chat
AI_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AI_ALLOWED_MODULES=["trading","books","finance","health","planner","goals","knowledge"]
AI_MAX_CONTEXT_MESSAGES=40
AI_RAG_TOP_K=8

# Obsidian import-only (local vault path)
OBSIDIAN_VAULT_PATH=/Users/harrymati/Documents/EXECUTE- IQ200/EXECUTE
